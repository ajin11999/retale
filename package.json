{
  "name": "retale",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "bun run --filter @retale/api dev",
    "test": "bun test",
    "typecheck": "bun run --filter @retale/api typecheck",
    "db:generate": "bun run --filter @retale/api db:generate",
    "db:migrate": "bun run --filter @retale/api db:migrate",
    "db:seed": "bun run --filter @retale/api db:seed",
    "jobs:run": "bun run --filter @retale/api jobs:run"
  }
}
