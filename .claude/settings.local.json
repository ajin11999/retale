{
  "permissions": {
    "allow": [
      "PowerShell(Remove-Item *)",
      "PowerShell(Get-ChildItem -Recurse -File | Where-Object { $_.Name -match 'product' -or $_.Name -match 'Product' } | Select-Object -ExpandProperty FullName)",
      "Bash(git add *)",
      "Bash(git commit -m ' *)",
      "Bash(git push *)"
    ]
  }
}
