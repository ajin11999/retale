# Keep the image build context small and secrets out of images. The Dockerfiles
# copy explicit paths, so this mostly guards size (node_modules, Flutter
# packages) and safety (.env*, uploads).
.git
.claude
.codegraph
.deepseek
node_modules
**/node_modules
**/build
**/.svelte-kit
packages/console/$houdini
# packages/pos is a heavy Flutter package and normally excluded, but the caddy
# image bakes in the pre-built web bundle. Re-include only packages/pos/build/web:
# exclude each level's other contents, then carve out the path to the bundle.
packages/pos/*
!packages/pos/build
packages/pos/build/*
!packages/pos/build/web
packages/stockeeper
# packages/workshop is likewise heavy and excluded, but the caddy image bakes in
# its pre-built web bundle. Re-include only packages/workshop/build/web:
packages/workshop/*
!packages/workshop/build
packages/workshop/build/*
!packages/workshop/build/web
assets
docs
plugins
uploads
**/uploads
.env
.env.*
*.log
