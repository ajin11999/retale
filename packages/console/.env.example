# GraphQL endpoint used by server-side requests (login, auth guard) and by
# Houdini codegen (`houdini generate`).
GRAPHQL_URL=http://localhost:3000/graphql

# GraphQL endpoint the browser uses for the Houdini client. On a LAN, set this
# to the API host's IP so client-side navigations can reach it.
PUBLIC_GRAPHQL_URL=http://localhost:3000/graphql
