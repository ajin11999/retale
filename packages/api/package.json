{
  "name": "@retale/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:db:setup": "bun run scripts/setup-test-db.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run scripts/migrate.ts",
    "db:seed": "bun run scripts/seed-templates.ts",
    "schema:dump": "bun run scripts/dump-schema.ts",
    "dev:seed-user": "bun run scripts/seed-dev-user.ts",
    "dev:seed-products": "bun run scripts/seed-dev-products.ts",
    "dev:seed-open-price": "bun run scripts/seed-open-price.ts",
    "dev:seed-receiving": "bun run scripts/seed-dev-receiving.ts",
    "jobs:run": "bun run scripts/run-scheduled-jobs.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@vercel/blob": "^2.3.3",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.28",
    "graphql": "^16.14.0",
    "graphql-yoga": "^5.21.0",
    "jose": "^6.2.3",
    "mysql2": "^3.22.3",
    "pdf-lib": "^1.17.1",
    "sharp": "^0.34.5",
    "ulid": "^3.0.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "drizzle-kit": "^0.31.10",
    "typescript": "^6.0.3"
  }
}
