DATABASE_URL=mysql://produck:password@127.0.0.1:3306/retale
# Separate database for `bun test` (the suites truncate tables). Create and
# migrate it once with `bun run test:db:setup`.
TEST_DATABASE_URL=mysql://produck:password@127.0.0.1:3306/retale_test
JWT_SIGNING_KEY=replace-with-a-long-random-string-for-hs512
TWO_FACTOR_ENC_KEY=replace-with-a-long-random-passphrase-any-length
PORT=3000

# Offline invoice OCR (open-source Tesseract via tesseract.js — no internet, no AI).
# Both optional. Language data is bundled at packages/api/assets/tessdata; add more
# `<lang>.traineddata` files there and list them with `+` (e.g. eng+ind).
OCR_LANGS=eng
# TESSDATA_PREFIX=/abs/path/to/tessdata   # override the bundled traineddata dir

# Vendor-pricelist AI ingest (OpenAI-compatible Chat Completions — optional).
# Absence surfaces as NOT_CONFIGURED; an unreachable host as LLM_UNREACHABLE
# (fail fast, no local fallback — use manual entry or CSV import instead).
#   OpenAI:   https://api.openai.com/v1
#   DeepSeek: https://api.deepseek.com/v1
#   Gemini:   https://generativelanguage.googleapis.com/v1beta/openai/
#   Claude:   via an OpenAI-compatible gateway (e.g. https://openrouter.ai/api/v1
#             with LLM_MODEL=anthropic/claude-...), since its native API differs.
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
