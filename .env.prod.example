# Secrets/config for the production LAN stack (docker-compose.prod.yml).
# Copy to .env.prod (gitignored) and fill in real values, then:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# Static LAN IP of the host running the stack (use a router DHCP reservation).
# Caddy issues its TLS certs for this IP; clients browse https://<HOST_IP>.
HOST_IP=192.168.1.10

# MariaDB — generate fresh strong passwords, do not reuse the dev ones.
MARIADB_PASSWORD=replace-me
MARIADB_ROOT_PASSWORD=replace-me

# API secrets — long random strings (e.g. `openssl rand -base64 48`).
JWT_SIGNING_KEY=replace-me
TWO_FACTOR_ENC_KEY=replace-me

# Optional: catalog snapshot publishing to Vercel Blob. Needs outbound
# internet; leave empty on an air-gapped LAN (publishing is then disabled).
BLOB_READ_WRITE_TOKEN=

# Only for the pre-built-image stack (docker-compose.dist.yml): which image tag
# to run. Defaults to `latest`; pin a release (e.g. v2026.06.15) for repeatable
# deploys. Ignored by the build-from-source docker-compose.prod.yml.
RETALE_TAG=latest
